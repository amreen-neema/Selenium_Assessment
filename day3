package Assesment;
import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.WebDriver;
public class Day3testcase2 {
public static void main(String[] args) throws InterruptedException {
		
		WebDriver driver = new EdgeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(15));
		driver.navigate().to("https://demoapps.qspiders.com/ui/datePick?sublist=0");
		Thread.sleep(3000);
		
		//clicking on calender
		WebElement date = driver.findElement(By.xpath("//input[@placeholder='Select A Date']"));
		date.click();
		Thread.sleep(2000);
		
		//navigating to next month
		driver.findElement(By.xpath("//button[@aria-label='Next Month']")).click();
		
		//clicking on date
		driver.findElement(By.xpath("//div[@aria-label='Choose Thursday, October 15th, 2026']")).click();
		Thread.sleep(2000);
		
		//validating the date
		String validate = date.getAttribute("Value");
		if (validate.equals("15/10/2026"))
		{
			System.out.println("Date is displayed");
		}
		else
		{
			System.out.println("Date is not displayed");
		}
		driver.quit();
	}

}
